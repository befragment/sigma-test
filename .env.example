# Подключение к БД (внутри docker-compose хост — postgres)
DATABASE_URL=postgresql+asyncpg://timesheet:timesheet@postgres:5432/timesheet
# Токены ботов через запятую. Пусто — сервис стартует без Telegram-поллинга.
BOT_TOKENS=
# Значение заголовка X-Admin-Token для всех ручек, кроме /health
ADMIN_TOKEN=change-me
# Количество воркеров обработки, размер пачки, пауза при пустой очереди (сек)
WORKERS=2
BATCH_SIZE=100
POLL_INTERVAL=1.0
LOG_LEVEL=INFO

# Только для тестов, запускаемых с хоста
TEST_DATABASE_URL=postgresql+asyncpg://timesheet:timesheet@localhost:5432/timesheet_test
